{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "SqlServer", "MigrateOnStartup": true },
  "ConnectionStrings": {
    "Wings": "Server=.;Database=WingsTestOrchestrator;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Auth": {
    "Jwt": { "Issuer": "wings-test-orchestrator", "Audience": "wings-test-orchestrator", "SigningKey": "", "AccessTokenMinutes": 480 }
  },
  "Storage": { "RootPath": "App_Data/storage" },
